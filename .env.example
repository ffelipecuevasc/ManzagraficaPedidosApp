# Plantilla de variables de entorno de Manza Gráfica App.
# Copia este archivo como .env (no se versiona) y completa los valores.
# Nunca escribas valores reales en esta plantilla.

# Clave secreta de Django. Obligatoria. Cadena larga y aleatoria, distinta en cada entorno;
# nunca reutilices una clave que haya estado en el historial de Git.
SECRET_KEY=

# Modo de depuración: True solo en desarrollo; en producción, False o sin definir.
DEBUG=

# Dominios desde los que se puede abrir la aplicación, separados por comas y sin espacios.
# Si está vacía o no se define, solo se permite localhost y 127.0.0.1. Nunca '*'.
# En producción debe contener el dominio de PythonAnywhere.
ALLOWED_HOSTS=

# Conexión completa a la base de datos, en formato mysql://usuario:contraseña@host:puerto/base.
# Solo en producción. Si se define, reemplaza a las variables DB_* de abajo.
DATABASE_URL=

# Base de datos local (MySQL en Docker, compose.yaml). Se usan solo si DATABASE_URL no está definida.
# Nombre de la base. Si está vacía: manzagrafica_local.
DB_NAME=
# Usuario de MySQL. Si está vacía: root.
DB_USER=
# Contraseña del usuario. Obligatoria en local, sin valor por defecto. compose.yaml la usa
# también como contraseña de root del contenedor.
DB_PASSWORD=
# Servidor de MySQL. Si está vacía: 127.0.0.1.
DB_HOST=
# Puerto de MySQL. Si está vacía: 3306. compose.yaml publica el contenedor en este puerto.
DB_PORT=